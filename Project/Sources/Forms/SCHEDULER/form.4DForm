{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"events": [
		"onLoad",
		"onUnload",
		"onClick",
		"onDataChange",
		"onTimer",
		"onActivate",
		"onPageChange"
	],
	"windowTitle": ":xliff:schedulerWindowTitle",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"intro": {
					"type": "text",
					"text": ":xliff:schedulerIntro",
					"top": 16,
					"left": 20,
					"width": 440,
					"height": 34,
					"class": "schedulerMuted"
				},
				"mode": {
					"type": "tab",
					"top": 62,
					"left": 20,
					"width": 440,
					"height": 200,
					"dataSource": "Form:C1466.modeTab",
					"dataSourceTypeHint": "object",
					"action": "gotoPage",
					"focusable": false,
					"events": [
						"onClick"
					]
				},
				"summaryText": {
					"type": "input",
					"enterable": false,
					"focusable": false,
					"borderStyle": "none",
					"events": [
						"onClick"
					],
					"contextMenu": "none",
					"fill": "transparent",
					"top": 536,
					"left": 25,
					"width": 432,
					"height": 34,
					"dataSource": "Form:C1466.summaryText",
					"multiline": "yes",
					"wordwrap": "normal",
					"verticalAlign": "top",
					"class": "schedulerMuted"
				},
				"schedulerErrorBox": {
					"type": "rectangle",
					"top": 413,
					"left": 20,
					"width": 440,
					"height": 96,
					"borderRadius": 8,
					"class": "schedulerErrorBox",
					"visibility": "hidden"
				},
				"error": {
					"type": "input",
					"enterable": false,
					"focusable": false,
					"borderStyle": "none",
					"events": [
						"onClick"
					],
					"contextMenu": "none",
					"top": 413,
					"left": 30,
					"width": 416,
					"height": 97,
					"dataSource": "Form:C1466.errorText",
					"multiline": "yes",
					"wordwrap": "normal",
					"verticalAlign": "middle",
					"visibility": "hidden",
					"class": "schedulerErrorMsg"
				},
				"forceNow": {
					"type": "button",
					"text": ":xliff:schedulerForceNow",
					"top": 582,
					"left": 20,
					"width": 90,
					"height": 26,
					"style": "regular",
					"events": [
						"onClick"
					]
				},
				"close": {
					"type": "button",
					"text": ":xliff:schedulerClose",
					"top": 582,
					"left": 295,
					"width": 76,
					"height": 26,
					"style": "regular",
					"sizingX": "move",
					"events": [
						"onClick"
					]
				},
				"save": {
					"type": "button",
					"text": ":xliff:schedulerSave",
					"defaultButton": true,
					"top": 582,
					"left": 384,
					"width": 76,
					"height": 26,
					"style": "regular",
					"sizingX": "move",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/save.4dm"
				}
			}
		},
		{
			"objects": {}
		},
		{
			"objects": {
				"intervalHours.label": {
					"type": "text",
					"text": ":xliff:schedulerEveryHours",
					"top": 124,
					"left": 40,
					"width": 80,
					"height": 20
				},
				"intervalHours": {
					"type": "input",
					"top": 122,
					"left": 124,
					"width": 56,
					"height": 17,
					"dataSource": "Form:C1466.intervalHours",
					"dataSourceTypeHint": "integer",
					"events": [
						"onDataChange"
					],
					"entryFilter": "&9",
					"textAlign": "right"
				},
				"schedulerHoursLabel": {
					"type": "text",
					"text": ":xliff:schedulerHoursUnit",
					"top": 124,
					"left": 190,
					"width": 60,
					"height": 20
				},
				"startFromReference": {
					"type": "radio",
					"text": ":xliff:schedulerStartFromFixed",
					"top": 152,
					"left": 40,
					"width": 400,
					"height": 20,
					"dataSource": "Form:C1466.startFromReference",
					"radioGroup": "startFrom",
					"events": [
						"onClick"
					]
				},
				"anchorText": {
					"type": "input",
					"enterable": false,
					"focusable": false,
					"borderStyle": "none",
					"events": [
						"onClick"
					],
					"contextMenu": "none",
					"fill": "transparent",
					"top": 176,
					"left": 62,
					"width": 240,
					"height": 18,
					"dataSource": "Form:C1466.anchorText",
					"class": "schedulerMuted"
				},
				"resetAnchor": {
					"type": "button",
					"text": ":xliff:schedulerResetAnchor",
					"top": 172,
					"left": 320,
					"width": 126,
					"height": 24,
					"style": "regular",
					"events": [
						"onClick"
					]
				},
				"startFromLast": {
					"type": "radio",
					"text": ":xliff:schedulerStartFromLast",
					"top": 204,
					"left": 40,
					"width": 400,
					"height": 20,
					"dataSource": "Form:C1466.startFromLast",
					"radioGroup": "startFrom",
					"events": [
						"onClick"
					]
				}
			}
		},
		{
			"objects": {
				"dailyTime.label": {
					"type": "text",
					"text": ":xliff:schedulerAtTime",
					"top": 136,
					"left": 40,
					"width": 80,
					"height": 20
				},
				"dailyTime": {
					"type": "input",
					"top": 134,
					"left": 130,
					"width": 64,
					"height": 17,
					"dataSource": "Form:C1466.dailyTime",
					"dataSourceTypeHint": "text",
					"textAlign": "center",
					"events": [
						"onDataChange"
					],
					"placeholder": "HH:MM"
				},
				"dailyTimeStepper": {
					"type": "stepper",
					"dataSource": "Form:C1466.dailyTimeValue",
					"dataSourceTypeHint": "time",
					"top": 132,
					"left": 198,
					"width": 16,
					"height": 22,
					"min": 0,
					"max": 86340,
					"step": 60,
					"events": [
						"onDataChange"
					]
				}
			}
		}
	],
	"geometryStamp": 411,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"formClass": "_SCHEDULER",
	"rightMargin": 20,
	"bottomMargin": 20,
	"windowMinHeight": 240,
	"method": "FORM_MANAGER",
	"windowMinWidth": 480,
	"css": [
		{
			"path": "SCHEDULER.css",
			"media": "mac"
		},
		{
			"path": "SCHEDULER.css",
			"media": "windows"
		}
	],
	"windowSizingX": "fixed",
	"width": 480,
	"height": 624
}
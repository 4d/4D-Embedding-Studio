<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<xliff version="1.0" xmlns:d4="http://www.4d.com/d4-ns">
  <file datatype="x-STR#" original="Undefined" source-language="en" target-language="fr">
    <header>
      <prop-group name="4DPop XLIFF Pro">
        <prop prop-type="version">3.0</prop>
      </prop-group>
    </header>
    <body>
      <group resname="Studio">
        <trans-unit id="aliasChangeConfirm" resname="aliasChangeConfirm">
          <source>The AI model behind {count} embedding definition(s) with existing data has changed. Reset these embeddings now so they are recomputed on the next run?</source>
          <target>Le modèle d'IA associé à {count} définition(s) d'embedding contenant déjà des données a changé. Réinitialiser ces embeddings maintenant afin qu'ils soient recalculés lors de la prochaine exécution ?</target>
        </trans-unit>
        <trans-unit id="45" resname="dataclass">
          <source>Dataclass</source>
          <target>Dataclass</target>
        </trans-unit>
        <trans-unit id="55" resname="vector">
          <source>Vector</source>
          <target>Vecteur</target>
        </trans-unit>
        <trans-unit id="emptyStateTitle" resname="emptyStateTitle">
          <source>Nothing to configure yet</source>
          <target>Rien à configurer pour l'instant</target>
        </trans-unit>
        <trans-unit id="emptyStateIntro" resname="emptyStateIntro">
          <source>To get started:</source>
          <target>Pour commencer :</target>
        </trans-unit>
        <trans-unit id="emptyStateStep1" resname="emptyStateStep1">
          <source>Open the Structure Editor.</source>
          <target>Ouvrez l'éditeur de structure.</target>
        </trans-unit>
        <trans-unit id="emptyStateStep2" resname="emptyStateStep2">
          <source>Add a field to the table you want to search and set its class to 4D.Vector.</source>
          <target>Ajoutez un champ à la table dans laquelle vous voulez rechercher et définissez sa classe sur 4D.Vector.</target>
        </trans-unit>
        <trans-unit id="emptyStateStep3" resname="emptyStateStep3">
          <source>Come back here to define the field's phrase and model alias.</source>
          <target>Revenez ici pour définir la phrase et l'alias de modèle du champ.</target>
        </trans-unit>
        <trans-unit id="studioIntro" resname="studioIntro">
          <source>Embedding Studio turns each record into a vector, so your app can find records by meaning rather than by exact words.
Pick a vector attribute, then describe a record in one sentence.</source>
          <target>Embedding Studio transforme chaque enregistrement en vecteur, pour que votre application retrouve les enregistrements par le sens plutôt que par les mots exacts. Choisissez un attribut vecteur, puis décrivez un enregistrement en une phrase.</target>
        </trans-unit>
        <trans-unit id="50" resname="explanatoryPhrase">
          <source>Descriptive Phrase</source>
          <target>Phrase descriptive</target>
        </trans-unit>
        <trans-unit id="52" resname="model">
          <source>Model</source>
          <target>Modèle</target>
        </trans-unit>
        <trans-unit id="autoInvalidateOnSave" resname="autoInvalidateOnSave">
          <source>Auto-invalidate on save</source>
          <target>Invalider automatiquement à l'enregistrement</target>
        </trans-unit>
        <trans-unit id="48" resname="embed">
          <source>Insert</source>
          <target>Insérer</target>
        </trans-unit>
        <trans-unit id="57" resname="vectorStudio">
          <source>Embedding Studio</source>
          <target>Embedding Studio</target>
        </trans-unit>
        <trans-unit id="schedulerHoursUnit" resname="schedulerHoursUnit">
          <source>hours</source>
          <target>heures</target>
        </trans-unit>
      </group>
      <group resname="Models">
        <trans-unit id="29" resname="name">
          <source>Name</source>
          <target>Nom</target>
        </trans-unit>
        <trans-unit id="28" resname="models">
          <source>Models</source>
          <target>Modèles</target>
        </trans-unit>
        <trans-unit id="18" resname="apiKey">
          <source>API Key</source>
          <target>Clé API</target>
        </trans-unit>
        <trans-unit id="21" resname="baseURL">
          <source>Base URL</source>
          <target>URL de base</target>
        </trans-unit>
        <trans-unit id="36" resname="project">
          <source>Project</source>
          <target>Projet</target>
        </trans-unit>
        <trans-unit id="37" resname="selectAModel">
          <source>Select a model alias</source>
          <target>Sélectionnez un alias de modèle</target>
        </trans-unit>
        <trans-unit id="59" resname="createAModel">
          <source>Create a model alias…</source>
          <target>Créer un alias de modèle…</target>
        </trans-unit>
      </group>
      <group resname="Common">
        <trans-unit id="2" resname="cancel">
          <source>Cancel</source>
          <target>Annuler</target>
        </trans-unit>
        <trans-unit id="4" resname="done">
          <source>Done</source>
          <target>Fermer</target>
        </trans-unit>
        <trans-unit id="moreInformation" resname="moreInformation">
          <source>More information</source>
          <target>Plus d'informations</target>
        </trans-unit>
        <trans-unit id="schedulerWindowTitle" resname="schedulerWindowTitle">
          <source>Embedding Scheduler</source>
          <target>Planificateur d'embeddings</target>
        </trans-unit>
        <trans-unit id="schedulerIntro" resname="schedulerIntro">
          <source>Automatically recompute the embedding vectors defined for your dataclasses. Choose when this task runs.</source>
          <target>Recalcule automatiquement les vecteurs d'embedding définis pour vos dataclasses. Choisissez quand cette tâche s'exécute.</target>
        </trans-unit>
        <trans-unit id="schedulerModeDisabled" resname="schedulerModeDisabled">
          <source>Disabled</source>
          <target>Désactivé</target>
        </trans-unit>
        <trans-unit id="schedulerModeInterval" resname="schedulerModeInterval">
          <source>At a regular interval</source>
          <target>À intervalle régulier</target>
        </trans-unit>
        <trans-unit id="schedulerModeDaily" resname="schedulerModeDaily">
          <source>Once a day</source>
          <target>Une fois par jour</target>
        </trans-unit>
        <trans-unit id="schedulerEveryHours" resname="schedulerEveryHours">
          <source>Run every</source>
          <target>Exécuter toutes les</target>
        </trans-unit>
        <trans-unit id="schedulerStartFromLast" resname="schedulerStartFromLast">
          <source>after the previous run ends</source>
          <target>après la fin de l&apos;exécution précédente</target>
        </trans-unit>
        <trans-unit id="schedulerAtTime" resname="schedulerAtTime">
          <source>Run at</source>
          <target>Exécuter à</target>
        </trans-unit>
        <trans-unit id="schedulerNextRun" resname="schedulerNextRun">
          <source>Next run:</source>
          <target>Prochaine exécution :</target>
        </trans-unit>
        <trans-unit id="schedulerState" resname="schedulerState">
          <source>State:</source>
          <target>État :</target>
        </trans-unit>
        <trans-unit id="schedulerLastRun" resname="schedulerLastRun">
          <source>Last run:</source>
          <target>Dernière exécution :</target>
        </trans-unit>
        <trans-unit id="schedulerForceNow" resname="schedulerForceNow">
          <source>Run now</source>
          <target>Exécuter maintenant</target>
        </trans-unit>
        <trans-unit id="schedulerForceNowTipStopped" resname="schedulerForceNowTipStopped">
          <source>Start the scheduler to run it now</source>
          <target>Démarrez le planificateur pour l'exécuter maintenant</target>
        </trans-unit>
        <trans-unit id="schedulerForceNowTipRunning" resname="schedulerForceNowTipRunning">
          <source>A run is already in progress</source>
          <target>Une exécution est déjà en cours</target>
        </trans-unit>
        <trans-unit id="schedulerStart" resname="schedulerStart">
          <source>Start scheduler</source>
          <target>Démarrer le planificateur</target>
        </trans-unit>
        <trans-unit id="schedulerStop" resname="schedulerStop">
          <source>Stop scheduler</source>
          <target>Arrêter le planificateur</target>
        </trans-unit>
        <trans-unit id="schedulerCancel" resname="schedulerCancel">
          <source>Cancel run</source>
          <target>Annuler l'exécution</target>
        </trans-unit>
        <trans-unit id="schedulerConfigure" resname="schedulerConfigure">
          <source>Configure scheduler…</source>
          <target>Configurer le planificateur…</target>
        </trans-unit>
        <trans-unit id="schedulerStateRunning" resname="schedulerStateRunning">
          <source>Running</source>
          <target>En cours</target>
        </trans-unit>
        <trans-unit id="schedulerStateDisabled" resname="schedulerStateDisabled">
          <source>No schedule</source>
          <target>Pas de planification</target>
        </trans-unit>
        <trans-unit id="schedulerStateArmed" resname="schedulerStateArmed">
          <source>Scheduled</source>
          <target>Planifié</target>
        </trans-unit>
        <trans-unit id="schedulerStateIdle" resname="schedulerStateIdle">
          <source>Schedule idle</source>
          <target>Planification inactive</target>
        </trans-unit>
        <trans-unit id="schedulerSave" resname="schedulerSave">
          <source>Save</source>
          <target>Enregistrer</target>
        </trans-unit>
        <trans-unit id="schedulerClose" resname="schedulerClose">
          <source>Cancel</source>
          <target>Annuler</target>
        </trans-unit>
        <trans-unit id="schedulerStartFromFixed" resname="schedulerStartFromFixed">
          <source>on a fixed schedule</source>
          <target>à horaire fixe</target>
        </trans-unit>
        <trans-unit id="schedulerAnchorFrom" resname="schedulerAnchorFrom">
          <source>from {date}</source>
          <target>à partir du {date}</target>
        </trans-unit>
        <trans-unit id="schedulerResetAnchor" resname="schedulerResetAnchor">
          <source>Reset to now</source>
          <target>Repartir de maintenant</target>
        </trans-unit>
        <trans-unit id="schedulerSummaryPending" resname="schedulerSummaryPending">
          <source>Not saved yet.</source>
          <target>Pas encore enregistré.</target>
        </trans-unit>
        <trans-unit id="schedulerSummaryDisabled" resname="schedulerSummaryDisabled">
          <source>No automatic recalculation.</source>
          <target>Aucun recalcul automatique.</target>
        </trans-unit>
        <trans-unit id="schedulerSummaryInterval" resname="schedulerSummaryInterval">
          <source>Recalculates every {hours}, on a fixed schedule from {anchor}.</source>
          <target>Recalcule toutes les {hours}, à horaire fixe à partir du {anchor}.</target>
        </trans-unit>
        <trans-unit id="schedulerSummaryIntervalLast" resname="schedulerSummaryIntervalLast">
          <source>Recalculates {hours} after each run ends.</source>
          <target>Recalcule {hours} après la fin de chaque exécution.</target>
        </trans-unit>
        <trans-unit id="schedulerSummaryDaily" resname="schedulerSummaryDaily">
          <source>Recalculates every day at {time}.</source>
          <target>Recalcule chaque jour à {time}.</target>
        </trans-unit>
        <trans-unit id="schedulerSummaryNext" resname="schedulerSummaryNext">
          <source>Next: {when} ({relative}).</source>
          <target>Prochaine : {when} ({relative}).</target>
        </trans-unit>
        <trans-unit id="schedulerHoursOne" resname="schedulerHoursOne">
          <source>1 hour</source>
          <target>1 heure</target>
        </trans-unit>
        <trans-unit id="schedulerHoursMany" resname="schedulerHoursMany">
          <source>{n} hours</source>
          <target>{n} heures</target>
        </trans-unit>
        <trans-unit id="schedulerRelDue" resname="schedulerRelDue">
          <source>due now</source>
          <target>imminente</target>
        </trans-unit>
        <trans-unit id="schedulerRelSoon" resname="schedulerRelSoon">
          <source>in less than a minute</source>
          <target>dans moins d&apos;une minute</target>
        </trans-unit>
        <trans-unit id="schedulerRelMinutes" resname="schedulerRelMinutes">
          <source>in {n} min</source>
          <target>dans {n} min</target>
        </trans-unit>
        <trans-unit id="schedulerRelHours" resname="schedulerRelHours">
          <source>in {h} h {m} min</source>
          <target>dans {h} h {m} min</target>
        </trans-unit>
      </group>
